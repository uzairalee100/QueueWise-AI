# ===== QueueWise AI — Environment Configuration =====
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ----- Application -----
APP_NAME=QueueWise AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key

# ----- Backend Server -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ----- Database -----
# For local dev, use SQLite:
DATABASE_URL=sqlite+aiosqlite:///./queuewise.db
# For production, use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/queuewise

# ----- AI / LLM Provider -----
# Supported: openai, gemini, none
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ----- Speech Recognition -----
# Supported: browser, google, none
SPEECH_PROVIDER=browser

# ----- Text-to-Speech -----
# Supported: browser, google, none
TTS_PROVIDER=browser

# ----- Notifications -----
NOTIFICATION_TURN_APPROACHING_THRESHOLD=3

# ----- Simulation -----
SIMULATION_DEFAULT_SEED=42

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT=json
